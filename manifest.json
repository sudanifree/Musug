{
  "manifest_version": 3,
  "name": "صفحات فيسبوك الموثقة",
  "version": "1.0.0",
  "description": "يعرض صفحات فيسبوك التي تظهر عليها شارة التوثيق في الصفحة الحالية.",
  "action": {
    "default_title": "الصفحات الموثقة",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}